# App starts in the clearly labeled synthetic demo until live providers are verified.
APP_DATA_MODE=demo

# Bind locally by default. Set this to the server's VPN interface address for private remote access.
APP_BIND_HOST=127.0.0.1

# Fuyao REST mode; keep the key in a server-side secret store.
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# Reserved; no iFinD adapter has been implemented yet.
IFIND_MCP_URL=
IFIND_ACCESS_TOKEN=

# OpenAI Chat Completions-compatible model endpoint; server-side only, HTTPS required.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Optional DeepSeek Chat Completions setting; disables default chain-of-thought for concise JSON output.
MODEL_THINKING_MODE=
